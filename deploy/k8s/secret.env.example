# Copy this file to `secret.env` (gitignored) before running
# `kubectl apply -k deploy/k8s/`. Kustomize's secretGenerator turns this
# into a Secret named `slink-secrets`.
#
# Generate SECRET_KEY with: openssl rand -hex 32
# Use a strong POSTGRES_PASSWORD — it's also referenced by the Postgres
# StatefulSet.

DATABASE_URL=postgresql+asyncpg://slink:CHANGE_ME@slink-postgres:5432/slink
SECRET_KEY=replace-with-openssl-rand-hex-32
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_TOO
POSTGRES_PASSWORD=CHANGE_ME

# Notification channels — leave empty to disable.
PUSHOVER_API_TOKEN=
PUSHOVER_USER_KEY=
TEAMS_WEBHOOK_URL=

# AI advisory triage (optional; never suppresses deterministic incident alerts).
ANTHROPIC_API_KEY=

# Optional collectors.
CS_CLIENT_ID=
CS_CLIENT_SECRET=
OTX_API_KEY=

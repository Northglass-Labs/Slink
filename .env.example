# ---------------------------------------------------------------------------
# Slink configuration — copy to .env and fill in real values.
# Nothing in this file is a real secret; everything is a placeholder.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Replace YOUR_DB_PASSWORD with a strong password of your choosing.
DATABASE_URL=postgresql+asyncpg://slink:YOUR_DB_PASSWORD@db:5432/slink
TEST_DATABASE_URL=postgresql+asyncpg://slink:YOUR_DB_PASSWORD@localhost:5433/slink_test
POSTGRES_PASSWORD=YOUR_DB_PASSWORD

# --- Auth ------------------------------------------------------------------
# Generate SECRET_KEY with: openssl rand -hex 32
# Slink refuses to boot with weak placeholders when APP_ENV=production.
SECRET_KEY=generate-with-openssl-rand-hex-32
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# --- AI triage (recommended) ------------------------------------------------
# Adds advisory context to the emergency path. Incident-linked detections are
# always treated as emergencies; model output cannot suppress deterministic policy.
ANTHROPIC_API_KEY=your-anthropic-api-key
AI_SUMMARY_DAILY_LIMIT=100
AI_SUMMARY_USER_DAILY_LIMIT=25
AI_SUMMARY_MAX_CONCURRENCY=2
AI_SUMMARY_LEASE_SECONDS=90

# --- Notification channels --------------------------------------------------
# Pushover — pushover.net. User key OR delivery group key both work.
PUSHOVER_API_TOKEN=your-pushover-app-token
PUSHOVER_USER_KEY=your-pushover-user-or-group-key

# Teams webhook — Power Automate "When a HTTP request is received" flow URL.
TEAMS_WEBHOOK_URL=your-teams-webhook-url

# --- Optional collectors ----------------------------------------------------
# Any collector with empty credentials is skipped — start with just Pushover +
# Anthropic if you don't have these yet and add them later.

# CrowdStrike Falcon Recon + Intel
CS_CLIENT_ID=your-client-id
CS_CLIENT_SECRET=your-client-secret
CS_BASE_URL=https://api.crowdstrike.com
# Falcon console base for "open in Falcon" deep links in Teams alerts.
# Set to your tenant's region: us-1 (default) / us-2 / eu-1 / us-gov-1.
CS_FALCON_CONSOLE_BASE=https://falcon.us-1.crowdstrike.com

# AlienVault OTX (free — otx.alienvault.com)
OTX_API_KEY=your-otx-api-key

# abuse.ch — one Auth-Key authenticates ALL abuse.ch collectors:
# ThreatFox, URLhaus, MalwareBazaar, Feodo Tracker. Free registration at
# https://auth.abuse.ch (the same key works across every feed they publish).
# Auth-Key became mandatory across all abuse.ch feeds in 2025; collectors
# auto-disable when this is empty.
ABUSECH_AUTH_KEY=

# NVD CVE API 2.0 — optional but recommended.
# Works anonymously at 5 req / 30 s; a key lifts the limit to 50 req / 30 s.
# Free key request: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# GitHub Advisory Database — optional but recommended.
# Without a token, GraphQL is capped at 60 req/h (effectively unusable). With a
# token: 5,000 req/h. A classic PAT or fine-grained token with NO scopes works
# for public advisories. https://github.com/settings/tokens
# The collector returns an empty list when this is unset (collector disabled).
GITHUB_TOKEN=

# --- Runtime mode -----------------------------------------------------------
# Production is explicit: set APP_ENV=production, replace every required
# placeholder, set SECURE_COOKIES=true, and use a non-local HTTPS base URL.
# Startup fails closed if any production invariant is unsafe.
APP_ENV=development
SECURE_COOKIES=false

# External base URL used in notification deep-links.
SLINK_BASE_URL=http://localhost:5180

# Comma-separated CIDRs of direct reverse proxies allowed to provide forwarding
# headers. Leave empty for direct/local access. Never trust an entire private
# address range when a single proxy address or narrow subnet is available.
TRUSTED_PROXY_CIDRS=
